{
  "docker:build": "docker compose -f compose.prod.yaml build",
  "docker:dev:build": "docker compose -f compose.dev.yaml build",
  "docker:up": "docker compose -f compose.prod.yaml up -d",
  "docker:dev:up": "docker compose -f compose.dev.yaml up -d",
  "docker:down": "docker compose -f compose.prod.yaml down",
  "docker:dev:down": "docker compose -f compose.dev.yaml down",
  "docker:restart": "docker compose -f compose.prod.yaml restart",
  "docker:dev:restart": "docker compose -f compose.dev.yaml restart",
  "docker:logs": "docker compose -f compose.prod.yaml logs",
  "docker:dev:logs": "docker compose -f compose.dev.yaml logs",
  "docker:exec": "docker compose -f compose.prod.yaml exec app bash",
  "docker:dev:exec": "docker compose -f compose.dev.yaml exec app bash"
}
